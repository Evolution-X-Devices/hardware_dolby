// HIDL facade for the Qualcomm Codec2 store, see service.cpp.
cc_binary {
    name: "android.hardware.media.c2-qc2hidl-service",
    vendor: true,
    relative_install_path: "hw",

    init_rc: ["android.hardware.media.c2-qc2hidl-service.rc"],
    vintf_fragments: ["manifest_media_c2_qc2hidl.xml"],

    defaults: [
        "libcodec2-hidl-defaults",
    ],

    srcs: ["service.cpp"],

    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
    ],

    // The factory is a stock vtable called through a raw pointer, which the
    // cross-DSO CFI check in this binary would reject.
    sanitize: {
        cfi: false,
    },

    // libqcodec2_core.so is loaded with dlopen from the vendor partition.
}
