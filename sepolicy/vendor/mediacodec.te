allow mediacodec hal_dms_hwservice:hwservice_manager find;
binder_call(mediacodec, hal_dms_default)
hal_client_domain(mediacodec, hal_dms)

# Dolby Vision ambient light (LightSense -> ASensorManager)
allow mediacodec fwk_sensor_hwservice:hwservice_manager find;
binder_call(mediacodec, system_server)
binder_call(system_server, mediacodec)
