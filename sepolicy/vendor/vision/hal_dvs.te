# HwBinder IPC from client to server, and callbacks
binder_call(hal_dvs_client, hal_dvs_server)
binder_call(hal_dvs_server, hal_dvs_client)

add_hwservice(hal_dvs_server, hal_dvs_hwservice)
allow hal_dvs_client hal_dvs_hwservice:hwservice_manager find;

type hal_dvs_default, domain;
hal_server_domain(hal_dvs_default, hal_dvs)

type hal_dvs_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_dvs_default)

allow hal_dvs_default vendor_sysfs_graphics:dir r_dir_perms;
allow hal_dvs_default vendor_sysfs_graphics:file r_file_perms;
allow hal_dvs_default fwk_sensor_hwservice:hwservice_manager find;

set_prop(hal_dvs_server, vendor_dolbyv_prop)
